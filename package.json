{
  "name": "obsidian-workbench-explorer-sort",
  "version": "1.0.0",
  "private": true,
  "description": "Direct, rule-based sorting for the file explorer.",
  "main": "main.js",
  "bin": {
    "workbench-sort": "cli.js"
  },
  "scripts": {
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "lint": "eslint main.ts rules.ts sorting.ts tests",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^24.13.6",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
